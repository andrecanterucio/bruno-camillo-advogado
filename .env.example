# Copie para .env.local (não vai para o git). Tudo é opcional no localhost com --demo.

# --- Produção (npm start, sem --demo) ---
NODE_ENV=production
# Primeiro admin (o advogado). Em produção o painel fica bloqueado até ele aceitar o contrato.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=Bruno Camillo
# 1 = o admin criado pelo ambiente precisa trocar a senha no primeiro login (padrão)
ADMIN_FORCE_CHANGE=1
# Atrás do Traefik/Coolify: usar o IP real do visitante (último salto do x-forwarded-for).
# Sem isso, o limite de tentativas de login enxerga só o IP do proxy.
TRUST_PROXY=1
# Só se o domínio passar pela Cloudflare (cf-connecting-ip):
TRUST_CLOUDFLARE=0
# Pasta dos dados (banco SQLite e documentos). Em produção, um volume persistente com backup.
DATA_DIR=data
# Retenção da auditoria em dias (mínimo 183: Marco Civil, art. 15, registros de acesso por 6 meses)
AUDIT_RETENTION_DAYS=365

# --- DJEN (grátis): OAB do advogado e sufixos a consultar ('' = sem sufixo, A = suplementar) ---
# O DJEN só responde a IP do Brasil.
DJEN_OAB=56739
DJEN_UF=DF
DJEN_OAB_VARIANTES=,A

# --- DataJud (grátis): chave pública do CNJ, veja https://datajud-wiki.cnj.jus.br/api-publica/acesso ---
DATAJUD_API_KEY=
# O Termo de Uso do CNJ (V1.2, itens 3.3 e 3.8) veda uso comercial da API e das informações derivadas sem
# autorização escrita. Mantenha 0 até obter a autorização do CNJ; com 0 o botão do DataJud fica desligado.
DATAJUD_AUTORIZADO=0

# --- IA (custo ZACDA, centavos) ---
# Use uma chave DEDICADA a este painel, com limite de gasto no console da Anthropic
# Em desenvolvimento usa-se a chave ANTHROPIC_ADVOCATE_API_KEY (dedicada à advocacia) do zacda-app.
# A IA só liga depois de: contrato aceito, termo de IA do escritório aceito e IA habilitada caso a caso.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

PORT=3000
